{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/ads\\.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(?!assets/)(.*)",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "src": "/sitemap\\.xml", "dest": "https://api-videsaur.onrender.com/sitemap.xml" },
    { "src": "/sitemap-([^/]+)\\.xml", "dest": "https://api-videsaur.onrender.com/sitemap-$1.xml" },
    { "src": "/indexnow\\.txt", "dest": "https://api-videsaur.onrender.com/indexnow.txt" },
    { "src": "/api/location-theme", "dest": "https://api-videsaur.onrender.com/api/location-theme" },
    { "src": "/(?:prerender-pages\\.json|\\.prerender-template\\.html)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
