{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api-videsaur.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-:name.xml",
      "destination": "https://api-videsaur.onrender.com/sitemap-:name.xml"
    },
    {
      "source": "/indexnow.txt",
      "destination": "https://api-videsaur.onrender.com/indexnow.txt"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
